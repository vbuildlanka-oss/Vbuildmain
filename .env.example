# Copy to .env.local for local development. In production, set these in
# Vercel → Settings → Environment Variables (see ADMIN_SETUP.md).

# Supabase: Project URL and the publishable (or legacy "anon") key.
# Both are public by design; never put the secret / service_role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Cloudflare R2 (server only — used by api/upload.ts)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=vbuild-media
R2_PUBLIC_URL=https://media.your-domain.com

# Protects /api/keep-alive so only Vercel Cron can call it (any random 32+ characters)
CRON_SECRET=
